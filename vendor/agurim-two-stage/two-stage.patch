+/* Copyright (C) 2026. BSD-2-Clause, under the accompanying upstream LICENSE.
+ * Versioned residual transport, not a replacement for recursive lattice search.
+ */
+#include <sys/socket.h>
+#include <arpa/inet.h>
+#include <stdint.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <limits.h>
+#include <err.h>
+#include "agurim.h"
+
+int weights_mode;
+static int forbidden, m_count, t_count, h_count, n_count, w_count, flag_count;
+static const char *mode_arg, *thresh_arg, *hash_arg, *n_arg;
+static unsigned int output_stage, output_hash;
+static uint64_t blocks, total[3];
+static const char magic[8] = "AGWGT001";
+
+uint64_t weights_add(uint64_t a, uint64_t b) {
+    if (weights_mode && UINT64_MAX-a < b) errx(1,"weights: counter overflow");
+    return a+b;
+}
+uint64_t weights_sub(uint64_t a, uint64_t b) {
+    if (weights_mode && a < b) errx(1,"weights: counter underflow");
+    return a-b;
+}
+uint64_t weights_threshold(uint64_t a, int t) {
+    if (weights_mode && (t<1 || (UINT64_MAX-99)/(unsigned)t<a)) errx(1,"weights: threshold overflow");
+    uint64_t n=(a*t+99)/100;
+    if (weights_mode && disable_heuristics<2 && n>UINT64_MAX/4) errx(1,"weights: subattribute threshold overflow");
+    return n;
+}
+static uint64_t integer(const char *s,uint64_t min,uint64_t max) {
+    uint64_t n=0;
+    if (!s || !*s) errx(1,"weights: missing integer");
+    while (*s) { if (*s<'0'||*s>'9'||n>(max-(*s-'0'))/10) errx(1,"weights: invalid integer"); n=n*10+(*s++-'0'); }
+    if (n<min || n>max) errx(1,"weights: integer out of range");
+    return n;
+}
+void weights_option(int ch,const char *arg,int stage) {
+    if (!strchr(stage==1 ? "WmtDwH" : "WmtDwn",ch)) forbidden=1;
+    if(ch=='W')flag_count++;
+    if(ch=='m'){m_count++;mode_arg=arg;}
+    if(ch=='t'){t_count++;thresh_arg=arg;}
+    if(ch=='H'){h_count++;hash_arg=arg;}
+    if(ch=='n'){n_count++;n_arg=arg;}
+    if(ch=='w')w_count++;
+}
+void weights_validate(int argc,int used,int stage) {
+    if(!weights_mode)return;
+    if(forbidden || used!=argc || flag_count!=1 || m_count>1 || t_count>1 || h_count>1 || n_count>1 || w_count>1 || disable_heuristics>2)
+        errx(1,"weights: unsupported/duplicate options (both stages require the same mode, integer threshold, heuristics; no time aggregation/filter/top-k)");
+    if(mode_arg && strcmp(mode_arg,"packet") && strcmp(mode_arg,"byte") && strcmp(mode_arg,"flow") && strcmp(mode_arg,"combination"))errx(1,"weights: invalid basis");
+    if(thresh_arg)integer(thresh_arg,1,100);
+    if(hash_arg)integer(hash_arg,1,INT_MAX);
+    if(n_arg)integer(n_arg,0,0);
+    (void)stage;
+}
+static void put(const void *p,size_t n){if(fwrite(p,1,n,wfp)!=n)err(1,"weights write");}
+static void get(FILE *f,void *p,size_t n){if(fread(p,1,n,f)!=n)errx(1,"weights: truncated stream");}
+static void put32(uint32_t n){n=htonl(n);put(&n,4);}
+static uint32_t get32(FILE *f){uint32_t n;get(f,&n,4);return ntohl(n);}
+static void put64(uint64_t n){put32((uint32_t)(n>>32));put32((uint32_t)n);}
+static uint64_t get64(FILE *f){uint64_t hi=get32(f);return (hi<<32)|get32(f);}
+static void tag(FILE *f,const char *s){char v[4];get(f,v,4);if(memcmp(v,s,4))errx(1,"weights: invalid frame");}
+static void counts(const struct odflow *p,uint64_t v[3]){v[0]=p->packet;v[1]=p->byte;v[2]=p->flow;}
+static void putcounts(const uint64_t v[3]){for(int i=0;i<3;i++)put64(v[i]);}
+static void getcounts(FILE *f,uint64_t v[3]){for(int i=0;i<3;i++)v[i]=get64(f);}
+static void accumulate(uint64_t a[3],const uint64_t b[3]){for(int i=0;i<3;i++)a[i]=weights_add(a[i],b[i]);}
+static void same(const uint64_t a[3],const uint64_t b[3]){for(int i=0;i<3;i++)if(a[i]!=b[i])errx(1,"weights: counter conservation mismatch");}
+static void specput(const struct odflow_spec *s){put(s->src,16);put(s->dst,16);put(&s->srclen,1);put(&s->dstlen,1);}
+static void specget(FILE *f,struct odflow_spec *s,int bits){
+    memset(s,0,sizeof(*s));get(f,s->src,16);get(f,s->dst,16);get(f,&s->srclen,1);get(f,&s->dstlen,1);
+    if(s->srclen>bits || s->dstlen>bits)errx(1,"weights: invalid prefix length");
+    uint8_t src[16]={0},dst[16]={0};prefix_set(s->src,s->srclen,src,bits/8);prefix_set(s->dst,s->dstlen,dst,bits/8);
+    if(memcmp(src,s->src,16)||memcmp(dst,s->dst,16))errx(1,"weights: noncanonical prefix bits");
+}
+void weights_begin(int stage,unsigned int hash_limit){
+    output_stage=stage;output_hash=hash_limit;blocks=0;memset(total,0,sizeof(total));
+    put(magic,8);put32(query.criteria);put32(query.threshold);put32(disable_heuristics);put32(stage);put32(hash_limit);put32(0);
+}
+/* Preserve old address and protocol order and old no-label wildcard fallback.
+ * Missing protocol mass is an accounting field, never an extra odproto entry.
+ */
+void weights_block(struct response *resp){
+    struct odflow *p,*q;uint64_t naddr=0,nproto=0,expected[3]={resp->total_packet,resp->total_byte,resp->total_flow},sum[3]={0};
+    TAILQ_FOREACH(p,&resp->odfq.odfq_head,odf_chain){
+        uint64_t n=0;odproto_countsort(p);
+        TAILQ_FOREACH(q,&p->odf_odpq.odfq_head,odf_chain)if(q->s.srclen||q->s.dstlen)n++;
+        naddr++;nproto+=n?n:1;
+    }
+    put("BLK1",4);put64(blocks++);put64(resp->start_time);put64(resp->end_time);putcounts(expected);put64(naddr);put64(nproto);
+    TAILQ_FOREACH(p,&resp->odfq.odfq_head,odf_chain){
+        uint64_t v[3],lower[3]={0},deficit[3],n=0;
+        counts(p,v);accumulate(sum,v);
+        TAILQ_FOREACH(q,&p->odf_odpq.odfq_head,odf_chain)if(q->s.srclen||q->s.dstlen){uint64_t x[3];counts(q,x);accumulate(lower,x);n++;}
+        if(!n)memcpy(lower,v,sizeof(lower));
+        for(int i=0;i<3;i++)deficit[i]=weights_sub(v[i],lower[i]);
+        specput(&p->s);putcounts(v);put32(n?n:1);putcounts(deficit);
+        if(!n){struct odflow_spec zero;memset(&zero,0,sizeof(zero));specput(&zero);putcounts(v);}
+        else TAILQ_FOREACH(q,&p->odf_odpq.odfq_head,odf_chain)if(q->s.srclen||q->s.dstlen){uint64_t x[3];counts(q,x);specput(&q->s);putcounts(x);}
+    }
+    same(sum,expected);accumulate(total,sum);put("SUM1",4);putcounts(sum);put64(naddr);put64(nproto);
+    if(fflush(wfp))err(1,"weights flush");
+}
+void weights_finish(void){put("END1",4);put64(blocks);putcounts(total);if(fflush(wfp))err(1,"weights flush");}
+void weights_read(FILE *f,struct response *resp){
+    char m[8];get(f,m,8);if(memcmp(m,magic,8))errx(1,"weights: unsupported magic/version (legacy AGR is not weighted input)");
+    unsigned basis=get32(f),t=get32(f),h=get32(f),stage=get32(f),limit=get32(f),reserved=get32(f);
+    if(basis!=query.criteria||t!=query.threshold||h!=(unsigned)disable_heuristics||stage!=1||!limit||limit>INT_MAX||reserved)errx(1,"weights: stage/basis/settings mismatch");
+    weights_begin(2,limit);
+    uint64_t seq=0,totals[3]={0};
+    for(;;){
+        char frame[4];get(f,frame,4);
+        if(!memcmp(frame,"END1",4)){
+            uint64_t n=get64(f),v[3];getcounts(f,v);if(n!=seq)errx(1,"weights: block sequence mismatch");same(v,totals);
+            if(fgetc(f)!=EOF || ferror(f))errx(1,"weights: trailing bytes or input error");break;
+        }
+        if(memcmp(frame,"BLK1",4)||get64(f)!=seq++)errx(1,"weights: invalid block sequence");
+        uint64_t start=get64(f),end=get64(f),expected[3],sum[3]={0},na,np,actual_np=0;getcounts(f,expected);na=get64(f);np=get64(f);
+        if(end<start || start>UINT32_MAX || end>UINT32_MAX)errx(1,"weights: invalid timestamps");
+        if(seq==1||start<(uint64_t)resp->start_time)resp->start_time=start;
+        if(end>(uint64_t)resp->end_time)resp->end_time=end;
+        for(uint64_t i=0;i<na;i++){
+            struct odflow_spec s;uint64_t v[3],lower[3]={0},deficit[3];specget(f,&s,32);getcounts(f,v);
+            uint32_t n=get32(f);getcounts(f,deficit);if(!n)errx(1,"weights: missing protocol record/fallback");
+            struct odflow *p=odflow_addcount(&s,AF_INET,v[1],v[0],v[2],resp);accumulate(sum,v);
+            for(uint32_t j=0;j<n;j++){
+                struct odflow_spec sub;uint64_t x[3];specget(f,&sub,24);getcounts(f,x);accumulate(lower,x);
+                odproto_addcount(p,&sub,AF_LOCAL,x[1],x[0],x[2]);actual_np++;
+            }
+            accumulate(lower,deficit);same(lower,v);
+        }
+        if(actual_np!=np)errx(1,"weights: protocol count mismatch");same(sum,expected);accumulate(totals,sum);
+        tag(f,"SUM1");uint64_t trailer[3];getcounts(f,trailer);same(trailer,sum);
+        if(get64(f)!=na||get64(f)!=np)errx(1,"weights: trailer count mismatch");
+    }
+    (void)output_stage;(void)output_hash;
+}
